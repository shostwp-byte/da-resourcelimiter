# Default Resource Limits Configuration for DA-ResourceLimiter
# Format: DirectAdmin-compatible Key=Value (no spaces around '=')

ENABLED=yes
CUSTOM_OVERRIDE=no

# 1. OS Layer Limits (Linux Cgroups v2 / systemd user-<UID>.slice)
# 100 = 1 vCore, 150 = 1.5 vCores, 200 = 2 vCores
CPU_QUOTA=150
CPU_WEIGHT=100
MEM_HIGH_MB=1536
MEM_MAX_MB=2048
IO_WEIGHT=100
TASKS_MAX=100

# 2. PHP-FPM / LSPHP Pool Limits
PHP_MAX_CHILDREN=12
PHP_MEM_LIMIT_MB=256

# 3. MariaDB / MySQL Per-User Governor Limits
MYSQL_MAX_CONNECTIONS=20
MYSQL_MAX_ACTIVE_QUERIES=4
MYSQL_MAX_MEM_MB=256
MYSQL_MAX_STATEMENT_TIME_SEC=10
MYSQL_PENALTY_ENABLED=yes
MYSQL_PENALTY_THRESHOLD=5
MYSQL_PENALTY_WINDOW_SEC=60
MYSQL_PENALTY_DURATION_SEC=300
MYSQL_PENALTY_CONN=2
MYSQL_PENALTY_TIME_SEC=2
