[Unit]
Description=DirectAdmin Multi-Tier Resource Limiter Daemon (da-resourced)
Documentation=https://github.com/shostwp-byte/da-resourcelimiter
After=network.target mariadb.service mysqld.service directadmin.service
Wants=network.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/sbin/da-resourced serve
Restart=always
RestartSec=2s

# Protect root resource governor from host OOM Killer
OOMScoreAdjust=-900
LimitNOFILE=65535
UMask=0022

# Systemd sandboxing & privilege hardening (preserving cgroup v2, systemd slice & DA access)
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ReadWritePaths=-/home/mysql
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectControlGroups=no
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=da-resourced

[Install]
WantedBy=multi-user.target
